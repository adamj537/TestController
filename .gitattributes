# --- Normalize text files (good diffs, consistent line endings)
*                   text=auto
*.sh                text eol=lf
*.py                text eol=lf
*.ts                text eol=lf
*.js                text eol=lf
*.c                 text eol=lf
*.cpp               text eol=lf
*.h                 text eol=lf
*.md                text eol=lf
*.yml               text eol=lf
*.yaml              text eol=lf
*.json              text eol=lf
*.toml              text eol=lf
*.xml               text eol=lf
*.svg               text eol=lf    # keep as text (diff-friendly)