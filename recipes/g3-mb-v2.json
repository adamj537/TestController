{
  "recipeId": "g3-mb-v2",
  "recipeVersion": "2.2.13",
  "schemaVersion": 1,
  "name": "G3 Main Board \u2014 Full Production Test",
  "timeoutMs": 300000,
  "steps": [
    {
      "id": "i2c",
      "label": "TCC I2C Bus & Rail Check",
